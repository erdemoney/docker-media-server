# Repo backups with restic - copied to .env.restic by 'just init' (or copy by hand).
# These just recipes run restic in a container and pass this file via docker run
# --env-file, so everything defined below is forwarded to restic automatically.

# Documented backend: Cloudflare R2 (zero egress, same account as this stack). The
# RESTIC_REPOSITORY below is derived from R2_ACCOUNT_ID + R2_BUCKET by 'just init':
#
#   R2_ACCOUNT_ID     dash.cloudflare.com -> R2, scroll down: Usage -> Account Details
#                     (also where the S3 API endpoint lives)
#   R2_BUCKET         R2 dashboard -> Create bucket
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  R2 dashboard -> Manage R2 API Tokens
#   AWS_DEFAULT_REGION must stay "auto" for R2.
#
# Want a different backend? Edit RESTIC_REPOSITORY + creds here - that's the only
# supported deviation. Alternatives: Backblaze B2 (b2:my-bucket:my-path, cheaper
# storage; creds B2_ACCOUNT_ID + B2_ACCOUNT_KEY), sftp:user@host:/srv/restic,
# /mnt/backups/restic, rclone:remote:path, rest:https://user:pass@host:8000 ...
R2_ACCOUNT_ID=
R2_BUCKET=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Retention for 'just backup-prune' (restic forget --prune). 0 = keep nothing of that class.
RESTIC_KEEP_HOURLY=0
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
RESTIC_KEEP_YEARLY=0