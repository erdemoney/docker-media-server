# Repo backups with restic - copied to .env.backup by 'just init' (or copy by hand).
# These just recipes run restic in a container and pass this file via docker run
# --env-file, so RESTIC_REPOSITORY picks the backend and anything else you add below
# is forwarded along automatically. Backend-agnostic:
#
#   local dir:           /mnt/backups/restic
#   SFTP:                sftp:user@host:/srv/restic
#   S3-compatible:       s3:s3.amazonaws.com/my-bucket
#   Backblaze B2:        b2:my-bucket:my-path
#   Azure:               azure:container:/path
#   Google Cloud:        gs:my-bucket:/path
#   rclone:              rclone:remote:path
#   rest-server:         rest:https://user:pass@host:8000
#
# If a backend needs credentials, add them here too (they are forwarded the same way):
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   B2_ACCOUNT_ID=...
#   B2_ACCOUNT_KEY=...
#   RCLONE_CONFIG=...
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# Retention for 'just backup:prune' (restic forget --prune). 0 = keep nothing of that class.
RESTIC_KEEP_HOURLY=0
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
RESTIC_KEEP_YEARLY=0