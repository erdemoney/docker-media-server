{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "onboarding": false,
  "repositories": ["erdemoney/docker-media-server"],
  "gitAuthor": "renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "enabledManagers": ["docker-compose"],
  "dependencyDashboard": false,
  "timezone": "UTC",
  "schedule": ["* 6 * * *"],
  "labels": ["renovate"],
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "media-stack minor/patch",
      "groupSlug": "media-stack-minor-patch",
      "labels": ["renovate", "minor/patch"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "media-stack major",
      "groupSlug": "media-stack-major",
      "labels": ["renovate", "major"],
      "automerge": false
    }
  ]
}
