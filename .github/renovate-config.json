{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Media stack dependency dashboard",
  "enabledManagers": [
    "docker-compose"
  ],
  "extends": [
    "config:recommended"
  ],
  "gitAuthor": "renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "labels": [
    "renovate"
  ],
  "onboarding": false,
  "packageRules": [
    {
      "automerge": false,
      "groupName": "media-stack minor/patch",
      "groupSlug": "media-stack-minor-patch",
      "labels": [
        "renovate",
        "minor/patch"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "automerge": false,
      "groupName": "media-stack major",
      "groupSlug": "media-stack-major",
      "labels": [
        "renovate",
        "major"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "repositories": [
    "erdemoney/docker-media-server"
  ],
  "schedule": [
    "* 6 * * *"
  ],
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "timezone": "UTC"
}
