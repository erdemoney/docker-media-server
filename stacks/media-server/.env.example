SUB_DOMAIN_SONARR=sonarr
SUB_DOMAIN_PROWLARR=prowlarr
SUB_DOMAIN_PROFILARR=profilarr
SUB_DOMAIN_BAZARR=bazarr
SUB_DOMAIN_DECYPHARR=decypharr
