DOMAIN=fromnowhere.net
# Absolute path where app config lives. `just init` fills this in — it defaults to
# the repo checkout's data/ dir (a relative answer is auto-resolved to absolute).
CONFIG_DIR=

SUB_DOMAIN_TRAEFIK=traefik

CF_DNS_API_TOKEN=
TRAEFIK_DASHBOARD_CREDENTIALS=

# Shared between the crowdsec container (BOUNCER_KEY_TRAEFIK) and the bouncer plugin.
# Generate once with: openssl rand -hex 32
CROWDSEC_BOUNCER_API_KEY=
